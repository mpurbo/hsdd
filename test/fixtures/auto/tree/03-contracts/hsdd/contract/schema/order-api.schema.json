{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "order-api/v1",
  "$comment": "order-api@v1: the Order resource and the error envelope",
  "$defs": {
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sku", "qty", "unit_cents"],
      "properties": {
        "sku": { "type": "string", "minLength": 1 },
        "qty": { "type": "integer", "minimum": 1 },
        "unit_cents": { "type": "integer", "minimum": 0 }
      }
    },
    "order": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "customer_id", "lines", "total_cents", "status", "created_at"],
      "properties": {
        "id": { "type": "string", "pattern": "^ord_[0-9A-HJKMNP-TV-Z]{26}$" },
        "customer_id": { "type": "string", "minLength": 1 },
        "lines": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/line" } },
        "total_cents": { "type": "integer", "minimum": 0 },
        "status": { "enum": ["placed", "paid", "cancelled"] },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" }
      }
    }
  },
  "oneOf": [{ "$ref": "#/$defs/order" }, { "$ref": "#/$defs/error" }]
}
